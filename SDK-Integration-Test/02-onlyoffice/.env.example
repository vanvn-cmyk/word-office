# Port cho Node.js callback server
PORT=5178

# Port mà ONLYOFFICE Document Server chạy (docker-compose map sang 8090)
DOCS_PORT=8090

# Địa chỉ mà ONLYOFFICE Document Server dùng để gọi lại Node.js
# Docker Desktop for Mac: host.docker.internal
# Linux: 172.17.0.1 hoặc $(ip route | awk '/default/ {print $3}')
CALLBACK_HOST=host.docker.internal
